"""Ridge"""

import pandas as pd
import numpy as np
from sklearn.preprocessing import StandardScaler
from xgboost import XGBRegressor
from sklearn.linear_model import Ridge
from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error
import joblib

df["gas_target_ridge"] = df["avg_gas_price_gwei"].shift(-1)
df = df.dropna()

# 2️⃣ Chọn features và target mới
features_ridge = [
    'gas_t-1', 'gas_t-5', 'gas_t-15',
    'gas_rolling_5', 'gas_rolling_15',
    'tx_count', 'total_gas_used', 'avg_block_full_ratio',
    'year', 'month', 'day', 'hour', 'minute'
]
target_ridge = "gas_target_ridge"


X_ridge = df[features_ridge].values
y_ridge = df[target_ridge].values

split_index_ridge = int(len(df) * 0.8)
X_train_ridge, X_test_ridge = X_ridge[:split_index_ridge], X_ridge[split_index_ridge:]
y_train_ridge, y_test_ridge = y_ridge[:split_index_ridge], y_ridge[split_index_ridge:]

scaler_ridge = StandardScaler()
X_train_scaled_ridge = scaler_ridge.fit_transform(X_train_ridge)
X_test_scaled_ridge = scaler_ridge.transform(X_test_ridge)

ridge_model = Ridge(alpha=1.0, random_state=42)
ridge_model.fit(X_train_scaled_ridge, y_train_ridge)

y_train_pred_ridge = ridge_model.predict(X_train_scaled_ridge)
y_test_pred_ridge = ridge_model.predict(X_test_scaled_ridge)

r2_train_ridge = r2_score(y_train_ridge, y_train_pred_ridge)
r2_test_ridge = r2_score(y_test_ridge, y_test_pred_ridge)

mae_train_ridge = mean_absolute_error(y_train_ridge, y_train_pred_ridge)
mae_test_ridge = mean_absolute_error(y_test_ridge, y_test_pred_ridge)

rmse_train_ridge = np.sqrt(mean_squared_error(y_train_ridge, y_train_pred_ridge))
rmse_test_ridge = np.sqrt(mean_squared_error(y_test_ridge, y_test_pred_ridge))

print(f"Train: R² = {r2_train_ridge:.3f}, MAE = {mae_train_ridge:.3f}, RMSE = {rmse_train_ridge:.3f}")
print(f"Test : R² = {r2_test_ridge:.3f}, MAE = {mae_test_ridge:.3f}, RMSE = {rmse_test_ridge:.3f}")

print("Rows:", len(df))
print("NA count:", df.isna().sum())
print(df.head(3))
print(df.tail(3))

joblib.dump(ridge_model, "ridge_forecast_model.pkl")
joblib.dump(scaler_ridge, "scaler_ridge_forecast.pkl")

import matplotlib.pyplot as plt

plt.figure(figsize=(15, 7))

plt.plot(y_test_ridge, label='Thực tế (t+1)', linewidth=1)
plt.plot(y_test_pred_ridge, label='Dự đoán Ridge (t+1)', linewidth=1, linestyle='--')

plt.title('Dự báo giá gas Ethereum 1 phút tiếp theo – Ridge Regression (Test Set)')
plt.xlabel('Chỉ số mẫu (time index)')
plt.ylabel('Giá gas (gwei)')
plt.legend()
plt.grid(True)

plt.show()

"""XGBoost"""

from xgboost import XGBRegressor
from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error
from sklearn.preprocessing import StandardScaler
import numpy as np
import matplotlib.pyplot as plt

df["gas_target_xgb"] = df["avg_gas_price_gwei"].shift(-1)
df = df.dropna()

features_xgb = [
    'gas_t-1', 'gas_t-5', 'gas_t-15',
    'gas_rolling_5', 'gas_rolling_15',
    'tx_count', 'total_gas_used', 'avg_block_full_ratio',
    'year', 'month', 'day', 'hour', 'minute'
]
target_xgb = 'gas_target_xgb'

X_xgb = df[features_xgb].values
y_xgb = df[target_xgb].values

split_index_xgb = int(len(df) * 0.8)
X_train_xgb, X_test_xgb = X_xgb[:split_index_xgb], X_xgb[split_index_xgb:]
y_train_xgb, y_test_xgb = y_xgb[:split_index_xgb], y_xgb[split_index_xgb:]

scaler_xgb = StandardScaler()
X_train_scaled_xgb = scaler_xgb.fit_transform(X_train_xgb)
X_test_scaled_xgb = scaler_xgb.transform(X_test_xgb)

xgb_model = XGBRegressor(
    n_estimators=500,
    learning_rate=0.05,
    max_depth=6,
    subsample=0.8,
    colsample_bytree=0.8,
    random_state=42,
    objective='reg:squarederror',
    n_jobs=-1,
    eval_metric='rmse'
)

xgb_model.fit(
    X_train_scaled_xgb, y_train_xgb,
    eval_set=[(X_train_scaled_xgb, y_train_xgb), (X_test_scaled_xgb, y_test_xgb)],
    verbose=False
)

y_train_pred_xgb = xgb_model.predict(X_train_scaled_xgb)
y_test_pred_xgb = xgb_model.predict(X_test_scaled_xgb)

r2_train_xgb = r2_score(y_train_xgb, y_train_pred_xgb)
r2_test_xgb = r2_score(y_test_xgb, y_test_pred_xgb)

mae_train_xgb = mean_absolute_error(y_train_xgb, y_train_pred_xgb)
mae_test_xgb = mean_absolute_error(y_test_xgb, y_test_pred_xgb)

rmse_train_xgb = np.sqrt(mean_squared_error(y_train_xgb, y_train_pred_xgb))
rmse_test_xgb = np.sqrt(mean_squared_error(y_test_xgb, y_test_pred_xgb))

print(f"Train -> R² = {r2_train_xgb:.3f}, MAE = {mae_train_xgb:.3f}, RMSE = {rmse_train_xgb:.3f}")
print(f"Test  -> R² = {r2_test_xgb:.3f}, MAE = {mae_test_xgb:.3f}, RMSE = {rmse_test_xgb:.3f}")

joblib.dump(xgb_model, "xgb_forecast_model.pkl")
joblib.dump(scaler_xgb, "scaler_xgb_forecast.pkl")

import matplotlib.pyplot as plt

plt.figure(figsize=(15, 7))

plt.plot(y_test_xgb, label='Thực tế (t+1)', linewidth=1)
plt.plot(y_test_pred_xgb, label='Dự đoán XGBoost (t+1)', linewidth=1, linestyle='--')

plt.title('Dự báo giá gas Ethereum 1 phút tiếp theo – XGBoost Regression (Test Set)')
plt.xlabel('Chỉ số thời gian (index)')
plt.ylabel('Giá gas (gwei)')
plt.legend()
plt.grid(True)

plt.show()

