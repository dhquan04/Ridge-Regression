import pandas as pd

# Đọc lại dữ liệu
df = pd.read_csv("/content/drive/MyDrive/eth_gas_1min.csv")
df

df.isnull().sum()

# Ép kiểu thời gian
df['time_1min'] = pd.to_datetime(df['time_1min'])

df['year'] = df['time_1min'].dt.year
df['month'] = df['time_1min'].dt.month
df['day'] = df['time_1min'].dt.day
df['hour'] = df['time_1min'].dt.hour
df['minute'] = df['time_1min'].dt.minute

import numpy as np

df = df.replace([np.inf, -np.inf], np.nan).dropna()
df = df[(df['avg_gas_price_gwei'] < df['avg_gas_price_gwei'].quantile(0.99)) &
        (df['avg_gas_price_gwei'] > df['avg_gas_price_gwei'].quantile(0.01))]

for lag in [1, 5, 15]:
    df[f'gas_t-{lag}'] = df['avg_gas_price_gwei'].shift(lag)

df['gas_rolling_5'] = df['avg_gas_price_gwei'].rolling(window=5).mean()
df['gas_rolling_15'] = df['avg_gas_price_gwei'].rolling(window=15).mean()

df = df.dropna().reset_index(drop=True)

df

